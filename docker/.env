# =====================================================================
# 文件名: docker/.env
# 所属模块: 项目基础设施（所有 docker-compose 文件共享的环境变量）
# 运行方式: 由 docker-compose 自动读取（执行 docker compose 命令时需在本目录或用 --env-file 指定）
# 说明: 统一管理镜像版本和端口，升级组件版本只需要改这里
# =====================================================================

# ---------- 镜像版本 ----------
# 版本选择原则：优先使用本机已缓存的官方镜像（离线可用），版本均满足
# 课程约束（Kafka 3.6+ / Flink 1.18+ / Spark 3.5+ / K8s 1.28+）。
# 若你需要在其他机器全新拉取，网络受限时可在镜像名前加 daocloud 前缀：
#   docker pull docker.m.daocloud.io/apache/flink:1.18.1
#   docker tag  docker.m.daocloud.io/apache/flink:1.18.1 apache/flink:1.18.1
# Kafka 4.x 为纯 KRaft（彻底移除 ZooKeeper），正是当前面试与生产的主流形态
KAFKA_IMAGE=apache/kafka:4.3.1
# Flink 1.18+ 稳定版，镜像自带 Java 11 运行时
FLINK_IMAGE=teleops/flink:1.18.1  # 本地构建（见 docker/flink-local/Dockerfile，内置 Kafka 连接器）；可直接拉取时改回 apache/flink:1.18.1
# Spark 3.5 官方镜像（v 前缀为 docker-official 历史命名，含 PySpark）
SPARK_IMAGE=apache/spark:v3.5.5
# Elasticsearch 8.12 单节点，关闭安全认证以便本地学习
ES_IMAGE=teleops/elasticsearch:8.12.2  # 本地构建（见 docker/es/Dockerfile）；可直接拉取时改回官方镜像
# Milvus 向量数据库（模块 30 RAG 使用），standalone 版依赖 etcd + minio
MILVUS_IMAGE=milvusdb/milvus:v2.4.4
ETCD_IMAGE=quay.io/coreos/etcd:v3.5.5
MINIO_IMAGE=minio/minio:RELEASE.2023-03-20T20-16-18Z
# 可观测性（Prometheus v3 / Grafana 11 为当前生产主流大版本）
PROMETHEUS_IMAGE=prom/prometheus:v3.2.1
GRAFANA_IMAGE=grafana/grafana:11.5.1
LOKI_IMAGE=grafana/loki:2.9.4
# Kafka 可视化管理界面
KAFKA_UI_IMAGE=provectuslabs/kafka-ui:v0.7.2
# K8s 学习工具容器（kubectl + helm + kind）；kind 集群节点镜像单独拉取：
#   docker pull docker.m.daocloud.io/kindest/node:v1.31.4
K8S_TOOLS_IMAGE=alpine/k8s:1.28.13
# Agent 服务基础镜像（本机已缓存）
PYTHON_IMAGE=python:3.11.14-slim-bookworm

# ---------- 端口规划（避免与本机常用端口冲突） ----------
# Kafka：对外暴露 39092-39094，容器内部 9092（客户端）/9093（KRaft Controller）
KAFKA_EXTERNAL_PORT_1=39092
KAFKA_EXTERNAL_PORT_2=39093
KAFKA_EXTERNAL_PORT_3=39094
KAFKA_UI_PORT=8980
# Flink JobManager Web UI
FLINK_UI_PORT=8081
# Spark Master/Worker/History UI
SPARK_MASTER_UI_PORT=8085
SPARK_WORKER_UI_PORT=8086
SPARK_HISTORY_UI_PORT=18085
# Elasticsearch
ES_HTTP_PORT=9200
# Milvus
MILVUS_PORT=19530
MILVUS_METRICS_PORT=9091
MINIO_API_PORT=19000
MINIO_CONSOLE_PORT=19001
# 可观测性
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
LOKI_PORT=3100
# AI Agent
MOCK_LLM_PORT=18000
AGENT_SERVICE_PORT=8100
MCP_SERVER_PORT=8300

# ---------- 业务参数 ----------
# Flink TaskManager 副本数：16GB 机器建议 2，8GB 轻量模式用 --scale flink-taskmanager=1
FLINK_TASKMANAGER_REPLICAS=2
# ES 堆内存（轻量模式可降到 256m）
ES_JAVA_OPTS=-Xms512m -Xmx512m
